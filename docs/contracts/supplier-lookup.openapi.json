  "components": {
    "securitySchemes": {
      "InternalApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Api-Key"
      }
    },
    "schemas": {
      "Capability": {
        "type": "object",
        "properties": {
          "process": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "material": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "monthly_capacity": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "process",
          "material",
          "monthly_capacity"
        ],
        "additionalProperties": false
      },
      "CatalogResponse": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "0.3"
          },
          "mode": {
            "type": "string",
            "const": "live"
          },
          "data": {
            "type": "object",
            "properties": {
              "processes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "process": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "\\S"
                    },
                    "materials": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "pattern": "\\S"
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "process",
                    "materials"
                  ],
                  "additionalProperties": false
                }
              },
              "regions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "\\S"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "processes",
              "regions"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schema_version",
          "mode",
          "data"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "request_id",
          "error"
        ],
        "additionalProperties": false
      },
      "ExistingContract": {
        "type": "object",
        "properties": {
          "payment_days": {
            "type": "integer",
            "minimum": 0
          },
          "price_linkage": {
            "type": "boolean"
          }
        },
        "required": [
          "payment_days",
          "price_linkage"
        ],
        "additionalProperties": false
      },
      "Financial": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 9999
          },
          "revenue_krw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "operating_profit_krw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "debt_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "DART",
              "MOCK"
            ]
          }
        },
        "required": [
          "year",
          "revenue_krw",
          "operating_profit_krw",
          "debt_ratio",
          "source"
        ],
        "additionalProperties": false
      },
      "Provenance": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "DART",
              "MOCK"
            ]
          },
          "financials": {
            "type": "string",
            "enum": [
              "DART",
              "MOCK"
            ]
          },
          "operations": {
            "type": "string",
            "const": "MOCK"
          }
        },
        "required": [
          "profile",
          "financials",
          "operations"
        ],
        "additionalProperties": false
      },
      "Quality": {
        "type": "object",
        "properties": {
          "defect_ppm": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "on_time_delivery_rate": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "defect_ppm",
          "on_time_delivery_rate"
        ],
        "additionalProperties": false
      },
      "Quote": {
        "type": "object",
        "properties": {
          "process": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "material": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "unit_price_krw": {
            "type": "number",
            "minimum": 0
          },
          "quoted_at": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "process",
          "material",
          "unit_price_krw",
          "quoted_at"
        ],
        "additionalProperties": false
      },
      "SupplierDetail": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "iatf16949": {
            "type": "boolean"
          },
          "iso14001": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "minItems": 1
          },
          "quality": {
            "$ref": "#/components/schemas/Quality"
          },
          "financials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Financial"
            }
          },
          "recent_quotes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Quote"
            }
          },
          "existing_contract": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExistingContract"
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "required": [
          "supplier_id",
          "name",
          "region",
          "iatf16949",
          "iso14001",
          "capabilities",
          "quality",
          "financials",
          "recent_quotes",
          "existing_contract",
          "provenance"
        ],
        "additionalProperties": false
      },
      "SupplierDetailResponse": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "0.3"
          },
          "mode": {
            "type": "string",
            "const": "live"
          },
          "data": {
            "$ref": "#/components/schemas/SupplierDetail"
          }
        },
        "required": [
          "schema_version",
          "mode",
          "data"
        ],
        "additionalProperties": false
      },
      "SupplierSearchResponse": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "0.3"
          },
          "mode": {
            "type": "string",
            "const": "live"
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SupplierSummary"
                },
                "maxItems": 100
              },
              "returned_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [
              "items",
              "returned_count",
              "limit"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schema_version",
          "mode",
          "data"
        ],
        "additionalProperties": false
      },
      "SupplierSummary": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "string",
