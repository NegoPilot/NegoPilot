# Copy to .env and set the selected provider's API key for the default live stack.
# compose.test.yaml runs deterministic stub chat with no provider key.
# Account and database values below are public LOCAL credentials, not deployment secrets.
LOCAL_WEB_PORT=5173
TEST_WEB_PORT=5174
LOCAL_ADMIN_EMAIL=admin@negopilot.local
LOCAL_ADMIN_PASSWORD=LocalAdmin2026!
LOCAL_USER_EMAIL=user@negopilot.local
LOCAL_USER_PASSWORD=LocalUser2026!
POSTGRES_PASSWORD=local-postgres-password
APP_DB_PASSWORD=local-app-password
BUSINESS_DB_PASSWORD=local-business-password
BUSINESS_READER_PASSWORD=local-reader-password
LOCAL_AGENT_API_KEY=local-agent-test-key
LOCAL_LAW_ADMIN_API_KEY=local-law-test-key

# Both AI phases default to OpenAI gpt-4.1-mini. Keys go only to the Agent.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NEGOPILOT_DECOMPOSER_BACKEND=openai
NEGOPILOT_GENERATOR_BACKEND=openai
# Empty MODEL uses the selected provider's core default. Whitespace is invalid.
# Defaults: openai=gpt-4.1-mini, anthropic=claude-opus-5-5, ollama=qwen3:8b.
NEGOPILOT_DECOMPOSER_MODEL=
NEGOPILOT_GENERATOR_MODEL=
# Effort and provider fallbacks are used by the Anthropic backend only.
NEGOPILOT_DECOMPOSER_EFFORT=low
NEGOPILOT_GENERATOR_EFFORT=medium
NEGOPILOT_DECOMPOSER_FALLBACKS=1
NEGOPILOT_GENERATOR_FALLBACKS=1
AGENT_REQUEST_TIMEOUT_SECONDS=300
AGENT_RESPONSE_TIMEOUT_SECONDS=310

# Optional external Ollama server. This Compose stack does not install or pull models.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=4096
