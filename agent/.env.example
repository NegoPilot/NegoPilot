# 분해 백엔드: anthropic(Claude, 기본) 또는 openai(gpt-4.1-mini)
NEGOPILOT_DECOMPOSER_BACKEND=anthropic

# anthropic: API 키 (또는 ant auth login 프로필을 쓰면 비워 둔다)
ANTHROPIC_API_KEY=
# 생략하면 anthropic은 claude-opus-5-5, openai는 gpt-4.1-mini
NEGOPILOT_DECOMPOSER_MODEL=
NEGOPILOT_DECOMPOSER_EFFORT=low
# 안전 분류기 거절 시 서버 측 대체 모델로 재실행 (0이면 끔)
NEGOPILOT_DECOMPOSER_FALLBACKS=1

# openai: API 키 (셸에 같은 변수가 있으면 그 값이 먼저 쓰인다)
OPENAI_API_KEY=

# Generation 백엔드: anthropic 또는 openai. 모델을 비우면 분해와 같은 기본값
NEGOPILOT_GENERATOR_BACKEND=anthropic
NEGOPILOT_GENERATOR_MODEL=
NEGOPILOT_GENERATOR_EFFORT=medium
NEGOPILOT_GENERATOR_FALLBACKS=1

# Routing: MCP 서버 주소 (Streamable HTTP)
BUSINESS_MCP_URL=http://localhost:9102/mcp
LAW_MCP_URL=http://localhost:9103/mcp
