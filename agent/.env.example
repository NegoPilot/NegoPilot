# 분해 백엔드: openai(gpt-4.1-mini, 기본) 또는 anthropic(Claude)
NEGOPILOT_DECOMPOSER_BACKEND=openai

# openai: API 키 (셸에 같은 변수가 있으면 그 값이 먼저 쓰인다)
OPENAI_API_KEY=

# 생략하면 openai는 gpt-4.1-mini, anthropic은 claude-opus-5-5
NEGOPILOT_DECOMPOSER_MODEL=
# 아래 두 값은 anthropic 전용
NEGOPILOT_DECOMPOSER_EFFORT=low
# 안전 분류기 거절 시 서버 측 대체 모델로 재실행 (0이면 끔)
NEGOPILOT_DECOMPOSER_FALLBACKS=1

# anthropic: API 키 (또는 ant auth login 프로필을 쓰면 비워 둔다)
ANTHROPIC_API_KEY=

# Generation 백엔드: openai(기본) 또는 anthropic. 모델을 비우면 백엔드별 기본 모델
NEGOPILOT_GENERATOR_BACKEND=openai
NEGOPILOT_GENERATOR_MODEL=
NEGOPILOT_GENERATOR_EFFORT=medium
NEGOPILOT_GENERATOR_FALLBACKS=1

# Routing: MCP 서버 주소 (Streamable HTTP)
BUSINESS_MCP_URL=http://localhost:9102/mcp
LAW_MCP_URL=http://localhost:9103/mcp

# LangSmith 추적 (선택, 기본 꺼짐). true와 키가 둘 다 있을 때만 켜진다
# 켜면 질문, 협력사 데이터, 법령 근거가 LangSmith로 전송된다. 키는 이 파일이 아니라 .env에만 넣는다
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=negopilot
# 입력·출력을 LangSmith에 남기지 않으려면 true (실행 구조와 시간·토큰만 남는다)
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
